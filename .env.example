NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Server-only service role key (Supabase dashboard -> Settings -> API keys).
# Used for analytics writes that must work for anonymous visitors. Never
# prefix with NEXT_PUBLIC_ and never use it in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key